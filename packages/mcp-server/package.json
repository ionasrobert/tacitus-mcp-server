{
  "name": "@dashiro/tacitus-mcp-server",
  "mcpName": "io.github.ionasrobert/tacitus-mcp-server",
  "version": "0.2.0",
  "description": "Tacitus MCP server (27 tools) - long-term agent memory with provenance, retrieval under token budgets, transactional write-back, typed notes, tasks, templates and quick capture. The native binary (same tools, zero deps, end-to-end encrypted multi-device sync) ships via GitHub Releases.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "agent-memory",
    "pkm",
    "knowledge-base",
    "model-context-protocol",
    "sync",
    "end-to-end-encryption"
  ],
  "bin": {
    "tacitus-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionasrobert/tacitus-mcp-server.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/ionasrobert/tacitus-mcp-server#readme",
  "bugs": "https://github.com/ionasrobert/tacitus-mcp-server/issues",
  "author": "Robert Ionas"
}
